{
  "schemaVersion": 1,
  "id": "bluemax-latest",
  "root": "source-latest",
  "sourceFiles": [
    "supabase/functions/submit-lead/index.ts"
  ],
  "protectedPaths": [
    "confam-runtime.mjs",
    "supabase/config.toml"
  ],
  "runtime": {
    "command": [
      "node",
      "confam-runtime.mjs"
    ],
    "readinessPath": "/confam-ready",
    "timeoutMs": 120000,
    "portVariable": "PORT",
    "dataVariable": "CONFAM_DATA",
    "restart": true,
    "workflowTimeoutMs": 90000
  }
}
