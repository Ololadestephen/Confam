{
  "schemaVersion": 1,
  "steps": [
    {
      "action": "navigate",
      "path": "/"
    },
    {
      "action": "fill",
      "locator": {
        "kind": "label",
        "value": "Phone number"
      },
      "value": {
        "fixture": "phone"
      }
    },
    {
      "action": "click",
      "locator": {
        "kind": "role",
        "value": "button",
        "name": "Continue"
      }
    },
    {
      "action": "wait",
      "locator": {
        "kind": "css",
        "value": "#appointments[aria-busy=\"false\"]"
      }
    },
    {
      "action": "fill",
      "locator": {
        "kind": "label",
        "value": "Date"
      },
      "value": {
        "fixture": "date"
      }
    },
    {
      "action": "select",
      "locator": {
        "kind": "label",
        "value": "Time"
      },
      "value": {
        "fixture": "time"
      },
      "by": "label"
    },
    {
      "action": "click",
      "locator": {
        "kind": "role",
        "value": "button",
        "name": "Book appointment"
      }
    },
    {
      "action": "wait",
      "locator": {
        "kind": "css",
        "value": "#booking-status:not(:empty)"
      }
    },
    {
      "action": "capture",
      "locator": {
        "kind": "role",
        "value": "status"
      },
      "kind": "text",
      "capture": "status"
    },
    {
      "action": "reached"
    },
    {
      "action": "assert",
      "expectationId": "confirmationMeansSaved",
      "actual": {
        "variable": "status"
      },
      "operator": "eq",
      "expected": "Booking confirmed"
    }
  ]
}