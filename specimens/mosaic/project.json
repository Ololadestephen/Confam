{
  "schemaVersion": 1,
  "id": "mosaic",
  "root": "source",
  "sourceFiles": [
    "src/server/auth/accounts.ts"
  ],
  "protectedPaths": [
    "confam-runtime.mjs",
    ".confam-deps.json",
    "scripts",
    "migrations"
  ],
  "runtime": {
    "command": [
      "node",
      "confam-runtime.mjs"
    ],
    "readinessPath": "/api/health",
    "timeoutMs": 120000,
    "portVariable": "PORT",
    "dataVariable": "CONFAM_DATA",
    "restart": false,
    "workflowTimeoutMs": 90000
  }
}
