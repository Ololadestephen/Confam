{
  "schemaVersion": 1,
  "steps": [
    {
      "action": "navigate",
      "path": "/"
    },
    {
      "action": "wait",
      "locator": {
        "kind": "css",
        "value": "#task[data-loaded='true']"
      }
    },
    {
      "action": "click",
      "locator": {
        "kind": "role",
        "value": "button",
        "name": "Complete task"
      }
    },
    {
      "action": "capture",
      "locator": {
        "kind": "css",
        "value": "#confirmation"
      },
      "kind": "text",
      "capture": "confirmMsg"
    },
    {
      "action": "capture",
      "locator": {
        "kind": "css",
        "value": "#task-state"
      },
      "kind": "text",
      "capture": "beforeState"
    },
    {
      "action": "reopen"
    },
    {
      "action": "wait",
      "locator": {
        "kind": "css",
        "value": "#task[data-loaded='true']"
      }
    },
    {
      "action": "capture",
      "locator": {
        "kind": "css",
        "value": "#task-state"
      },
      "kind": "text",
      "capture": "afterState"
    },
    {
      "action": "reached"
    },
    {
      "action": "assert",
      "expectationId": "completionPersists",
      "actual": {
        "variable": "afterState"
      },
      "operator": "eq",
      "expected": "Completed"
    }
  ]
}
