{
  "schemaVersion": 1,
  "purpose": "development",
  "probes": [
    {
      "id": "stateCompleted",
      "kind": "json-file",
      "path": "state",
      "pointer": [
        "tasks",
        "0",
        "completed"
      ],
      "expected": true
    }
  ],
  "decoys": [
    {
      "id": "undoSave",
      "patch": "development-undo-save.patch",
      "baseControl": "control-a",
